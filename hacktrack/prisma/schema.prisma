generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Stored in the legacy "Admin" table so existing accounts survive the move to multi-user.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  googleId     String? @unique
  name         String?
  image        String? @db.Text

  // Profile collected by the first-login onboarding wizard; editable from /account.
  // Defaults to false so accounts created before onboarding existed aren't sent through it.
  needsOnboarding Boolean @default(false)
  role            String?
  degree          String?
  fieldOfStudy    String?
  institution     String?
  graduationYear  Int?
  city            String?
  country         String?
  experienceLevel String?
  skills          String? @db.Text
  interests       String? @db.Text
  githubUrl       String?
  linkedinUrl     String?

  hackathons     Hackathon[]
  gmailToken     GoogleAuthToken?
  activityEvents ActivityEvent[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("Admin")
}

model GoogleAuthToken {
  id           String   @id @default(cuid())
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  tokenType    String   @default("Bearer")
  scope        String   @db.Text
  expiryDate   BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Hackathon {
  id                   String             @id @default(cuid())
  // Nullable only so existing rows can be migrated; run `npm run db:backfill-owner` after `db push`.
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  description          String             @db.Text
  roundDetails         String?            @db.Text
  hackathonDate        DateTime
  registrationDeadline DateTime
  fee                  String             @default("Free")
  location             String
  registrationLink     String?
  status               String             @default("ACTIVE")
  deletedAt            DateTime?
  participants         Participant[]
  scheduledMessages    ScheduledMessage[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([userId])
}

model Participant {
  id          String             @id @default(cuid())
  hackathonId String
  hackathon   Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  name        String
  email       String
  recipients  MessageRecipient[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([hackathonId, email])
  @@index([hackathonId])
}

model ScheduledMessage {
  id          String             @id @default(cuid())
  hackathonId String
  hackathon   Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  subject     String
  message     String             @db.Text
  scheduledAt DateTime
  status      String             @default("SCHEDULED")
  sentAt      DateTime?
  recipients  MessageRecipient[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([hackathonId])
  @@index([status, scheduledAt])
}

model MessageRecipient {
  id                 String           @id @default(cuid())
  scheduledMessageId String
  scheduledMessage   ScheduledMessage @relation(fields: [scheduledMessageId], references: [id], onDelete: Cascade)
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  status             String           @default("PENDING")
  sentAt             DateTime?
  errorMessage       String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([scheduledMessageId])
  @@index([participantId])
}

/// One row per qualifying HackTrack action, written only after the action succeeded.
/// Drives the HackTrack streak. Tied to the user (not the hackathon/participant), so deleting
/// a participant later doesn't erase the day it was added.
model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HACKATHON_CREATED | PARTICIPANT_ADDED | EMAIL_DELIVERED
  kind       String
  /// "<kind>:<source record id>" so retries and backfills can never double-count
  dedupeKey  String   @unique
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId, occurredAt])
}
