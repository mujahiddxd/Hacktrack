# Database Connection (PostgreSQL - Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/hacktrack?sslmode=require"

# Admin Authentication Session Secret
JWT_SECRET="hacktrack-neubrutalism-super-secure-key-2026"

# Default Admin Seed Credentials
ADMIN_EMAIL="admin@hacktrack.com"
ADMIN_PASSWORD="adminpassword123"

# Cron API Secret (for protecting /api/cron/process)
CRON_SECRET="hacktrack-cron-super-secret-2026"

# Google OAuth 2.0 Credentials (Gmail API)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
